# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/budgetwebdb

# Azure AD (MSAL) — not required in development
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
REDIRECT_URI=http://localhost:3000/redirect

# DevExpress license key
DX_LICENSE_KEY=

# Business rules
NORM_ALL_PER_DAY=5000
CANDELETEENTITIES=FALSE
CANCREATEUSER=FALSE
