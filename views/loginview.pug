extends layout

block content
  h1 #{title}

  form(method='POST', id='accountForm')
       
    div.form-group
    button.btn.btn-primary(type='button' , id='loginButton') Login
    button.btn.btn-primary(type='button' , id='logoutButton') Logout
    script.
      document.getElementById('loginButton').addEventListener('click', function() {
        console.log('loginButton');
          window.location.href = '/login';
        //- document.getElementById('currentAccounts').value = currentAccounts;
        //- console.log('!@!!currentAccounts', currentAccounts);
        //- document.getElementById('accountForm').submit();
      });     
      document.getElementById('logoutButton').addEventListener('click', function() {
        console.log('logoutButton');
         window.location.href = '/logout';
      });     

  if errors 
    ul
      for error in errors
        li!= error.msg
